{
  "name": "cinder",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --config .eslintrc.cjs . --ext .ts",
    "lint:boundaries": "ESLINT_USE_FLAT_CONFIG=false eslint --config .eslintrc.cjs . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:sim": "vitest run tests/sim",
    "sim:soak": "bun run tools/soak.ts",
    "sim:replay": "bun run tools/replay.ts",
    "restart:latency": "bun run tools/restart-latency.ts",
    "balance": "bun run tools/balance.ts",
    "perf:frame": "bun run tools/perf-frame.ts",
    "perf:soak": "bun run tools/soak.ts --ticks 10000 --entities 900",
    "report:build": "bun run tools/build-report.ts",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run sim:replay --ticks 2000 && bun run sim:soak --ticks 1000 --entities 120 && bun run restart:latency --iterations 200 && bun run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
